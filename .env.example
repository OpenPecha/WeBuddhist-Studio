VITE_BACKEND_BASE_URL="backendroute"
VITE_DEFAULT_LANGUAGE="en"
VITE_ENV_SALT="generatayoursalt"

# Auth0 SPA (public values only — never put client secrets in frontend env)
VITE_AUTH0_DOMAIN="your-tenant.auth0.com"
VITE_AUTH0_CLIENT_ID="your-spa-client-id"
VITE_AUTH0_AUDIENCE="webuddhist-backend"
VITE_AUTH0_SMS_CONNECTION="sms"
VITE_AUTH0_GOOGLE_CONNECTION="google-oauth2"
